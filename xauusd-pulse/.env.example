# Settings for the XAUUSD platform. Real values live in .env (never share or commit that file).
PORT=3000
HOST=127.0.0.1

# Live ticker: 'binance' (free PAXG ticks, no key) or 'mock' (fake ticks for offline testing)
PRICE_SOURCE=binance

# Real XAU/USD candles for signals and backtests. Free key from https://twelvedata.com
# Leave empty to run on clearly-labelled SAMPLE candles (fake data).
TWELVEDATA_API_KEY=

# Optional switches
# NEWS_SOURCE=rss                 # 'rss' (live) or 'sample'
# CALENDAR_SOURCE=faireconomy     # 'faireconomy' (live) or 'sample'
# TIMEFRAMES=H1,H4
# NEWS_POLL_MS=120000
# HISTORY_YEARS=8                 # how many years of candles to load (a one-off, about 15 free requests)
# EVENT_PAUSE=on                  # pause signals around big US events ('off' to disable)
# EVENT_PAUSE_BEFORE_MIN=30
# EVENT_PAUSE_AFTER_MIN=30
# EVENT_PAUSE_IMPACT=high         # or high,medium
# LAB_AUTO=on                     # re-run the test lab about once a day ('off' to disable)
# NEWS_FEEDS=https://example.com/feed.xml,https://example.org/rss   # replaces the default feeds
# DB_PATH=data/xauusd.db
